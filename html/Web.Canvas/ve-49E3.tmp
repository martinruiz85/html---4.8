        var user = {
            level: 1
        };

        var play = {
            transX: 0,
            transY: 0,
            color: "rgba(0, 0, 0, 0.87)",
            background: "#ffffff",
            map: [],
            word: [],
            wordcopy: [],
            drawobjects: [],
            status: 0,
            map_cols: 0,
            map_rows: 0,
            player: null,
            temporizador: null,
            inicia: function() {

                this.status = play.Estatus.Ini;

                this.map = levels["l{0}".format(user.level)].map;
                this.map_cols = this.map[0].length;
                this.map_rows = this.map.length;
                this.background = levels["l{0}".format(user.level)].background;
                this.color = levels["l{0}".format(user.level)].color;
                this.word = levels["l{0}".format(user.level)].word;
                //guardar copia de la palabra
                this.wordcopy = levels["l{0}".format(user.level)].word.slice(0, levels["l{0}".format(user.level)].word.length);
                this.drawobjects = [];
                this.arrange();

                var current_life = this.player ? this.player.getLife() > 0 ? this.player.getLife() : 3 : 3;
                this.player = new Player({
                    "x": 10,
                    "y": 10,
                    "w": (canvas_width - 20),
                    "h": 5,
                    "life": current_life
                });


                this.temporizador = new Time({
                    "x": (canvas_width - (canvas_width / 6)) / 2,
                    "y": 20,
                    "w": (canvas_width / 6),
                    "h": (canvas_width / 6),
                    "cicle": this.word.length * 3 //3 segundos por letra
                });

                play.Block = false;
                this.status = play.Estatus.Load;

            },
            draw: function(ctx) {

                if (this.status == play.Estatus.Load) {
                    ctx.save();

                    this.transX = (ctx.canvas.width - (this.map[0].length * square_width)) / 2;
                    this.transY = (ctx.canvas.height - (this.map.length * square_height)) / 2;
                    ctx.translate(this.transX, this.transY);
                    ctx.clearRect(-this.transX, -this.transY, ctx.canvas.width, ctx.canvas.height);
                    ctx.fillStyle = this.background;
                    ctx.fillRect(-this.transX, -this.transY, ctx.canvas.width, ctx.canvas.height)


                    /*
                    //border
                    ctx.beginPath();
                    ctx.lineWidth = "1";
                    //colir de linea
                    ctx.strokeStyle = "#ffffff";
                    //cols
                    for (var i = 0; i < this.map.length; i++) {
                    //rows
                    for (var j = 0; j < this.map[0].length; j++) {
                    ctx.rect(j * square_width, i * square_height, square_width, square_height);
                    }
                    }
                    ctx.stroke();
                    */

                    for (var i = 0; i < this.drawobjects.length; i++) {
                        this.drawobjects[i].draw(ctx);
                    }

                    //ctx.translate(.5, .5);
                    ctx.restore();
                    this.player.draw(ctx);

                    this.temporizador.draw(ctx);

                    /*
                    var blockscreen = new BlockScreen({
                    "x": 0,
                    "y": 0,
                    "w": canvas_width,
                    "h": canvas_height
                    });
                    blockscreen.draw(ctx);
                    */
                }
            },
            mousedown: function(e) {
                e = e || window.event;
                var target = e.target || e.srcElement;
                var mouseX = parseInt(e.clientX - target.offsetLeft - play.transX);
                var mouseY = parseInt(e.clientY - target.offsetTop - play.transY);

                var cur = {
                    "x": mouseX - (square_width * .5) / 2,
                    "y": mouseY - (square_height * .5) / 2,
                    "w": (square_width * 1) / 2,
                    "h": (square_height * 1) / 2
                };
                var mycursor = new Cursor({
                    "x": mouseX - (square_width * .5) / 2,
                    "y": mouseY - (square_height * .5) / 2,
                    "w": (square_width * 1) / 2,
                    "h": (square_height * 1) / 2
                });

                this.drawobjects.push(mycursor);

                for (var i = this.drawobjects.length - 1; i > -1; i--) {
                    if (this.drawobjects.indexOf(this.drawobjects[i]) == -1)
                        continue;
                    //if (this.drawobjects[i].isPointInside(mouseX, mouseY)) {
                    if (mycursor.intersects(//mycursor.getX(), mycursor.getY(), mycursor.getW(), mycursor.getH(),
                            cur.x, cur.y, cur.w, cur.h,
                            this.drawobjects[i].getX(), this.drawobjects[i].getY(), this.drawobjects[i].getW(), this.drawobjects[i].getH())
                        ) {
                        if (this.drawobjects[i].valid(i))
                            continue;
                        else
                            break;
                    }
                }

                //mycursor.Destructors();
                //this.drawobjects = arrayRemove(this.drawobjects, mycursor);
            },
            arrange: function() {
                //cols
                for (var i = 0; i < this.map.length; i++) {
                    //rows
                    for (var j = 0; j < this.map[0].length; j++) {
                        if (this.map[i][j] != " ") {

                            if (this.map[i][j] == 'time') {
                                this.drawobjects.push(new HourGlass({
                                    "x": j * square_width,
                                    "y": i * square_height,
                                    "w": square_width,
                                    "h": square_height
                                }));
                            }
                            else {
                                this.drawobjects.push(new Letter({
                                    "x": j * square_width,
                                    "y": i * square_height,
                                    "w": square_width,
                                    "h": square_height,
                                    "background": this.background,
                                    "color": this.color,
                                    "border_color": this.color,
                                    "text": this.map[i][j],
                                    "map": this.map,
                                    "opacity": 0,
                                    "hide": true
                                }));
                            }
                        }
                    }
                }

                //PONER UN ALPHA POR CADA GRUPO DE LETRAS IGUALES
                //play.drawobjects[0].SetIsAlpha(true);
                var array_alpha = [];
                for (var z = this.drawobjects.length - 1; z >= 0; z--) {
                    var currentValue = this.drawobjects[z];
                    if (currentValue.constructor === Letter && array_alpha.indexOf(currentValue.getText()) == -1) {
                        array_alpha.push(currentValue.getText());
                        currentValue.setIsAlpha(true);
                    }
                }
                /*
                this.drawobjects.forEach(function(currentValue, index, array) {
                if (currentValue.constructor === Letter && array_alpha.indexOf(currentValue.getText()) == -1) {
                array_alpha.push(currentValue.getText());
                currentValue.setIsAlpha(true);
                }
                });
                */

            }
        };
        play.Estatus = {};
        play.Estatus.Ini = 0;
        play.Estatus.Load = 1;
        play.Block = false;



        var lose = {
            background: "#000000",
            background: "#ffffff",
            drawobjects: [],
            inicia: function() {
                this.drawobjects = [];
                this.background = "#485460";
                var btn_star = new Button({
                    "x": (canvas_width - square_width * 4) / 2,
                    "y": (canvas_height - square_height) / 2,
                    "w": square_width * 4,
                    "h": square_height,
                    "color": "#ffffff",
                    "border_color": "#485460",
                    "text": "You lose"
                });
                var btn_continue = new Button({
                    "x": (canvas_width - square_width * 4) / 2,
                    "y": (canvas_height - square_height) / 2 + square_height + 4,
                    "w": square_width * 4,
                    "h": square_height,
                    "color": "#ffffff",
                    "fill": false,
                    "border_color": "#ffffff",
                    "text": "Continue"
                });
                var btn_restart = new Button({
                    "x": (canvas_width - square_width * 4) / 2,
                    "y": (canvas_height - square_height) / 2 + square_height * 2 + 4 * 2,
                    "w": square_width * 4,
                    "h": square_height,
                    "color": "#ffffff",
                    "fill": false,
                    "border_color": "#ffffff",
                    "text": "Restart"
                });
                this.drawobjects.push(btn_star);
                if (play.player.getLife() > 0)
                    this.drawobjects.push(btn_continue);
                this.drawobjects.push(btn_restart);

                btn_continue.array_click.push(function() {
                    play.temporizador.getTimer().pause();
                    for (var i = 0; i < play.drawobjects.length; i++) {
                        if (play.drawobjects[i].constructor === Letter) {
                            play.drawobjects[i].getTimer().pause();
                        }
                    }
                    play.inicia();
                    maquina.setStatus(2);
                });

                btn_restart.array_click.push(function() {
                    user.level = 1;
                    play.temporizador.getTimer().pause();
                    for (var i = 0; i < play.drawobjects.length; i++) {
                        if (play.drawobjects[i].constructor === Letter) {
                            play.drawobjects[i].getTimer().pause();
                        }
                    }
                    play.inicia();
                    maquina.setStatus(2);
                });
            },
            mousedown: function(e) {
                e = e || window.event;
                var target = e.target || e.srcElement;
                var mouseX = parseInt(e.clientX - target.offsetLeft - play.transX);
                var mouseY = parseInt(e.clientY - target.offsetTop - play.transY);
                for (var i = this.drawobjects.length - 1; i > -1; i--) {
                    if (this.drawobjects[i].isPointInside(mouseX, mouseY)) {
                        if (this.drawobjects[i].valid(i))
                            continue;
                        else
                            break;
                    }
                }
            },
            draw: function(ctx) {
                ctx.clearRect(0, 0, ctx.canvas.width, ctx.canvas.height);
                ctx.fillStyle = this.background;
                ctx.fillRect(0, 0, ctx.canvas.width, ctx.canvas.height)
                for (var i = 0; i < this.drawobjects.length; i++) {
                    this.drawobjects[i].draw(ctx);
                }
            }
        };


        var winner = {
            background: "#000000",
            background: "#ffffff",
            drawobjects: [],
            inicia: function() {
                this.drawobjects = [];
                var btn_star = new Button({
                    "x": (canvas_width - square_width * 4) / 2,
                    "y": (canvas_height - square_height) / 2,
                    "w": square_width * 4,
                    "h": square_height,
                    "text": "you winner"
                });
                this.drawobjects.push(btn_star);
                btn_star.array_click.push(function() {
                    play.inicia();
                    maquina.setStatus(2);
                });
            },
            draw: function(ctx) {
                ctx.clearRect(0, 0, ctx.canvas.width, ctx.canvas.height);
                ctx.fillStyle = this.background;
                ctx.fillRect(0, 0, ctx.canvas.width, ctx.canvas.height)
                for (var i = 0; i < this.drawobjects.length; i++) {
                    this.drawobjects[i].draw(ctx);
                }
            }
        };

        function arrayRemove(arr, value) {

            return arr.filter(function(ele) {
                return ele != value;
            });

        }

        var canvas_width = 0;
        var canvas_height = 0;
        var square_width = 0;
        var square_height = 0;

        window.addEventListener("resize", function() {
            //ciclo Principal
            // Get the device pixel ratio, falling back to 1.
            var dpr = window.devicePixelRatio || 1;

            var c = document.getElementById("myCanvas");
            var ctx = c.getContext("2d", { alpha: false });
            ctx.imageSmoothingEnabled = false;
            //ctx.translate(.5, .5);
            c.setAttribute("width", document.documentElement.offsetWidth);
            c.setAttribute("height", document.documentElement.offsetHeight);



            canvas_width = document.documentElement.offsetWidth;
            canvas_height = document.documentElement.offsetHeight;
            square_width = document.documentElement.offsetWidth / 10;
            square_height = square_width;

            //ctx.scale(dpr, dpr);


        });

        document.addEventListener("DOMContentLoaded", function(event) {

            //ciclo Principal
            // Get the device pixel ratio, falling back to 1.
            var dpr = window.devicePixelRatio || 1;

            var c = document.getElementById("myCanvas");
            var ctx = c.getContext("2d", { alpha: false });

            ctx.imageSmoothingEnabled = false;
            ctx.translate(.5, .5);
            c.setAttribute("width", document.documentElement.offsetWidth);
            c.setAttribute("height", document.documentElement.offsetHeight);

            canvas_width = document.documentElement.offsetWidth;
            canvas_height = document.documentElement.offsetHeight;
            square_width = document.documentElement.offsetWidth / 12;
            square_height = square_width;

            //ctx.scale(dpr, dpr);

            var timer = window.setInterval(function() {

                if (maquina.getStatus() == 1) {
                    incio.draw(ctx);
                }
                else if (maquina.getStatus() == 2) {
                    play.draw(ctx);
                }
                else if (maquina.getStatus() == 3) {
                    winner.draw(ctx);
                }
                else if (maquina.getStatus() == 4) {
                    lose.draw(ctx);
                }

            }, 20);

            incio.inicia();
            maquina.setStatus(1);

            var iniciar = document.getElementById("iniciar");
            iniciar.onclick = function() {
                user.level = 1;
                incio.inicia();
                maquina.setStatus(1);
            };

            var jugando = document.getElementById("jugando");
            jugando.onclick = function() {
                play.inicia();
                maquina.setStatus(2);
            };

            var terminar = document.getElementById("terminar");
            terminar.onclick = function() {
                lose.inicia();
                maquina.setStatus(4);
            };

            c.onmousedown = function(e) { handleMouseDown(e); };
            c.onmousemove = function(e) {
                // calculate the mouse click position
                var c = document.getElementById("myCanvas");

                if (maquina.getStatus() == 1) {
                    mouseX = parseInt(e.clientX - c.offsetLeft);
                    mouseY = parseInt(e.clientY - c.offsetTop);
                    //console.log(mouseX + "|" + mouseY);
                    for (var i = incio.drawobjects.length - 1; i > -1; i--) {
                        if (incio.drawobjects[i].isPointInside(mouseX, mouseY)) {
                            incio.drawobjects[i].onmouseover();
                        }
                        else {
                            incio.drawobjects[i].onmouseout();
                        }
                    }
                }
                else if (maquina.getStatus() == 2) {
                    mouseX = parseInt(e.clientX - c.offsetLeft - play.transX);
                    mouseY = parseInt(e.clientY - c.offsetTop - play.transY);
                    for (var i = play.drawobjects.length - 1; i > -1; i--) {
                    }
                }
                else if (maquina.getStatus() == 3) {
                    for (var i = lose.drawobjects.length - 1; i > -1; i--) {
                    }
                }
            };
        });

        function handleMouseDown(e) {
            e = e || window.event;


            // calculate the mouse click position
            var c = document.getElementById("myCanvas");
            mouseX = parseInt(e.clientX - c.offsetLeft);
            mouseY = parseInt(e.clientY - c.offsetTop);

            if (maquina.getStatus() == 1) {
                for (var i = incio.drawobjects.length - 1; i > -1; i--) {
                    if (incio.drawobjects[i].isPointInside(mouseX, mouseY)) {
                        incio.drawobjects[i].click();
                    }
                }
            }
            else if (maquina.getStatus() == 2) {
                if (play.Block == true)
                    return;
                play.mousedown(e);
            }
            else if (maquina.getStatus() == 4) {
                for (var i = lose.drawobjects.length - 1; i > -1; i--) {
                    if (lose.drawobjects[i].isPointInside(mouseX, mouseY)) {
                        lose.drawobjects[i].click();
                    }
                }
            }
        };
    
    </script>

</head>
<body>
    <canvas id="myCanvas" style="border: 0px solid #000;"></canvas>
    <input id="iniciar" value="iniciar" type="button" style="display: none;" />
    <input id="jugando" value="jugando" type="button" style="display: none;" />
    <input id="terminar" value="terminar" type="button" style="display: none;" />
</body>
</html>
