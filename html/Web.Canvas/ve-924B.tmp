                var $this = this;
                var c = document.createElement('canvas');
                c.width = 22;
                c.height = 22;
                var ctx = c.getContext("2d", { alpha: false });
                ctx.imageSmoothingEnabled = false;
                ctx.translate(.5, .5);
                $this.onDraw(ctx, 0, 0, 1);
                var image = c.toDataURL("image/png");
                var img = document.createElement('img');
                img.src = image;
                //img.style.border = "1px solid #000";
                document.body.appendChild(img);
                for (var i = 0; i < 4; i++) {
                    for (var j = 0; j < 4; j++) {
                        var bite = new Bite({
                            "sx": j * (20 / 4),
                            "sy": i * (20 / 4),
                            "x": $this.GetX() + j * (20 / 4),
                            "y": $this.GetY() + i * (20 / 4),
                            "w": 20 / 4,
                            "h": 20 / 4,
                            "image": img
                        });

                        bite_image.push(bite);
                    }
                }

                for (var b = 0; b < bite_image.length; b++) {
                    DrawObjects.push(bite_image[b]);
                }


                var clone_bites = bite_image.slice(0, bite_image.length);
                $this.Destroy({ "cicle": 10, "bites": bite_image, "clone_bites": clone_bites });
            };

            var t_destroy = null;
            this.Destroy = function(prms) {
                var $this = this;

                t_destroy = new Timer(function() {

                    var porcentaje = 1 - prms.cicle / 10;

                    for (var b = 0; b < prms.bites.length; b++) {
                        var polar = cartesian2Polar(
                            prms.clone_bites[b].GetX() - (prms.clone_bites[0].GetX() + (20 / 2)),
                            prms.clone_bites[b].GetY() - (prms.clone_bites[0].GetY() + (20 / 2))
                            );

                        var theta = polar.radians * (180 / Math.PI);

                        var new_x = (prms.bites[b].GetX()) + (10 * porcentaje) * Math.cos(polar.radians);
                        var new_y = (prms.bites[b].GetY()) + (10 * porcentaje) * Math.sin(polar.radians);

                        prms.bites[b].SetX(new_x);
                        prms.bites[b].SetY(new_y);

                        //prms.bites[b].SetX(prms.clone_bites[b].GetX() + 10 * porcentaje);
                        //prms.bites[b].SetY(prms.clone_bites[b].GetY() + 10 * porcentaje);

                        prms.bites[b].SetPorcent(porcentaje);
                    }

                    prms.cicle -= 1;
                    if (prms.cicle > -1)
                        $this.Destroy(prms);

                }, 50);

            };

            this.onDraw = function(ctx, x, y, porcent) {

                ctx.beginPath();
                if ($this.GetCharacter() == wordcopy[currentletter])
                //ctx.strokeStyle = "rgba(231,76,60," + $this.GetPorcent() + ")";
                    ctx.strokeStyle = "#e74c3c";
                else
